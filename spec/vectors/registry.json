    "profile-declaration/vectors.json": {
      "kind": "outcome-collection",
      "open_reasons": [
        "invalid_manifest_shape",
        "profile_mismatch",
        "unsupported_profile",
        "unsupported_version_newer"
      ],
      "lanes": {
        "js": {
